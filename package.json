{
  "name": "shiftclarity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:fixtures": "python3 handoff/spec-tests/test_fixture_integrity.py",
    "preview": "vite preview --host 127.0.0.1",
    "screenshots": "node tests/capture.mjs",
    "build:engine": "node scripts/build-engine.mjs",
    "pilot": "backend/.venv/bin/python scripts/run-pilot.py",
    "test:backend": "backend/.venv/bin/python -m pytest backend/tests -q",
    "test:pilot": "playwright test -c playwright.pilot.config.ts",
    "build:pages": "node scripts/build-pages.mjs",
    "test:landing": "playwright test -c playwright.landing.config.ts",
    "test:mvp": "playwright test -c playwright.mvp.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "decimal.js": "10.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  }
}
