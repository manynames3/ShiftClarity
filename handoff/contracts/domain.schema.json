{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:shiftclarity:domain:v1",
  "title": "ShiftClarity core domain contracts",
  "$defs": {
    "Money": {
      "type": "string",
      "pattern": "^-?(0|[1-9][0-9]*)\\.[0-9]{2}$"
    },
    "Rate": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{4}$"
    },
    "CoverageCategory": {
      "enum": [
        "evaluated_aligned",
        "evaluated_flagged",
        "abstained",
        "not_evaluated"
      ]
    },
    "ReviewState": {
      "enum": [
        "needs_review",
        "confirmed",
        "dismissed",
        "evidence_requested"
      ]
    },
    "Finding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "reason_code": {
          "type": "string"
        },
        "shift_ids": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "facility_id": {
          "type": "string"
        },
        "rule_version_id": {
          "type": "string"
        },
        "expected_amount": {
          "$ref": "#/$defs/Money"
        },
        "invoiced_amount": {
          "$ref": "#/$defs/Money"
        },
        "discrepancy_amount": {
          "$ref": "#/$defs/Money"
        },
        "currency": {
          "const": "USD"
        },
        "state": {
          "$ref": "#/$defs/ReviewState"
        },
        "collectibility": {
          "enum": [
            "unknown",
            "reviewed_collectible",
            "reviewed_not_collectible"
          ]
        }
      },
      "required": [
        "id",
        "reason_code",
        "shift_ids",
        "facility_id",
        "rule_version_id",
        "expected_amount",
        "invoiced_amount",
        "discrepancy_amount",
        "currency",
        "state",
        "collectibility"
      ]
    },
    "ReviewDecision": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "action": {
          "enum": [
            "confirm",
            "dismiss",
            "request_evidence"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 3,
          "maxLength": 2000
        },
        "expected_fingerprint": {
          "type": "string",
          "minLength": 8
        },
        "expected_version": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "action",
        "reason",
        "expected_fingerprint",
        "expected_version"
      ]
    },
    "CoverageTask": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "shift_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reason_code": {
          "type": "string"
        },
        "category": {
          "enum": [
            "abstained",
            "not_evaluated"
          ]
        },
        "amount": {
          "type": "null"
        }
      },
      "required": [
        "id",
        "shift_ids",
        "reason_code",
        "category",
        "amount"
      ]
    }
  }
}
